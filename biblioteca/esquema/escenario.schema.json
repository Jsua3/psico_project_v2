{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siep.local/biblioteca/escenario.schema.json",
  "title": "Escenario de la biblioteca (esquema 2 o 3; el 1 se acepta con aviso)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "esquema",
    "id",
    "nombre",
    "descripcion",
    "temas",
    "completo",
    "arteProvisional",
    "salas",
    "recorridosSugeridos",
    "catalogo",
    "personajes"
  ],
  "properties": {
    "esquema": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "id": {
      "$ref": "#/$defs/clave"
    },
    "nombre": {
      "$ref": "#/$defs/texto"
    },
    "descripcion": {
      "$ref": "#/$defs/texto"
    },
    "temas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clave"
      }
    },
    "completo": {
      "type": "boolean"
    },
    "arteProvisional": {
      "type": "boolean"
    },
    "salas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sala"
      }
    },
    "recorridosSugeridos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recorrido"
      }
    },
    "catalogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "muebles",
        "objetos",
        "herramientas"
      ],
      "properties": {
        "muebles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/muebleDeCatalogo"
          }
        },
        "objetos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objetoDeCatalogo"
          }
        },
        "herramientas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/herramienta"
          }
        }
      }
    },
    "personajes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/personaje"
      }
    },
    "hitos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hito"
      }
    },
    "nivelRiesgoPorDefecto": {
      "enum": [
        "VARIABLE",
        "MODERATE",
        "SEVERE",
        "EXTREME"
      ]
    }
  },
  "$defs": {
    "clave": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "texto": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "arte": {
      "type": "string",
      "pattern": "^(arte|piezas)/([a-z0-9-]+/)*[a-z0-9-]+\\.png$",
      "description": "Ruta de una imagen: `arte/…` es relativa a la carpeta del lugar; `piezas/…` (esquema 3) es del catálogo de piezas, relativa a `biblioteca/`."
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1920
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 528
    },
    "punto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
          "$ref": "#/$defs/y"
        }
      }
    },
    "sala": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "descripcion",
        "encuadre",
        "entrada",
        "muebles",
        "objetos",
        "personajes",
        "puertas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "descripcion": {
          "$ref": "#/$defs/texto"
        },
        "encuadre": {
          "enum": [
            "tres-paredes",
            "dos-paredes-izquierda",
            "dos-paredes-derecha",
            "una-pared"
          ]
        },
        "fondo": {
          "$ref": "#/$defs/arte"
        },
        "entrada": {
          "$ref": "#/$defs/punto"
        },
        "muebles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "x",
              "y",
              "espejo"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/clave"
              },
              "x": {
                "$ref": "#/$defs/x"
              },
              "y": {
                "$ref": "#/$defs/y"
              },
              "espejo": {
                "type": "boolean"
              }
            }
          }
        },
        "objetos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "x",
              "y"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/clave"
              },
              "x": {
                "$ref": "#/$defs/x"
              },
              "y": {
                "$ref": "#/$defs/y"
              }
            }
          }
        },
        "personajes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "x",
              "y",
              "mirando",
              "expresion"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/clave"
              },
              "x": {
                "$ref": "#/$defs/x"
              },
              "y": {
                "$ref": "#/$defs/y"
              },
              "mirando": {
                "enum": [
                  "izquierda",
                  "derecha",
                  "abajo",
                  "arriba",
                  "abajo-izquierda",
                  "abajo-derecha",
                  "arriba-izquierda",
                  "arriba-derecha"
                ]
              },
              "expresion": {
                "enum": [
                  "neutral",
                  "alegre",
                  "preocupada",
                  "triste",
                  "cautelosa",
                  "en-crisis"
                ]
              }
            }
          }
        },
        "puertas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "hacia",
              "etiqueta"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/clave"
              },
              "hacia": {
                "$ref": "#/$defs/clave"
              },
              "x": {
                "$ref": "#/$defs/x"
              },
              "y": {
                "$ref": "#/$defs/y"
              },
              "etiqueta": {
                "$ref": "#/$defs/texto"
              },
              "muro": {
                "enum": [
                  "fondo",
                  "izquierda",
                  "derecha",
                  "camara"
                ]
              },
              "pos": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1920
              },
              "modelo": {
                "$ref": "#/$defs/clave"
              },
              "par": {
                "$ref": "#/$defs/clave"
              },
              "sentidoUnico": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "x",
                  "y"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "muro"
                      ]
                    },
                    {
                      "required": [
                        "pos"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "muro",
                  "pos",
                  "modelo"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "x"
                      ]
                    },
                    {
                      "required": [
                        "y"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "estructura": {
          "type": "object",
          "description": "Esquema 3: la sala armada por piezas (contrato x-siep 2.2, sección 2). Su forma detallada y las reglas OCL-13 a 18 las juzga el servidor; aquí se exige el ancho del catálogo.",
          "required": [
            "ancho",
            "momento",
            "acabados",
            "piezas"
          ],
          "properties": {
            "ancho": {
              "enum": [
                960,
                1200,
                1440,
                1680,
                1920
              ]
            },
            "momento": {
              "enum": [
                "dia",
                "noche"
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "fondo"
          ],
          "not": {
            "required": [
              "estructura"
            ]
          }
        },
        {
          "required": [
            "estructura"
          ],
          "not": {
            "required": [
              "fondo"
            ]
          }
        }
      ]
    },
    "recorrido": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "descripcion",
        "salas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "descripcion": {
          "$ref": "#/$defs/texto"
        },
        "salas": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/clave"
          }
        }
      }
    },
    "muebleDeCatalogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "arte",
        "ancho",
        "alto",
        "colision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "arte": {
          "$ref": "#/$defs/arte"
        },
        "ancho": {
          "type": "integer",
          "minimum": 1,
          "maximum": 960
        },
        "alto": {
          "type": "integer",
          "minimum": 1,
          "maximum": 528
        },
        "colision": {
          "type": "boolean"
        },
        "huella": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ancho",
            "fondo",
            "alto"
          ],
          "description": "Esquema 3: la base del mueble en el piso (ancho × fondo) y su altura. Si está, el choque es la base y no la caja del dibujo.",
          "properties": {
            "ancho": {
              "type": "integer",
              "minimum": 1,
              "maximum": 528
            },
            "fondo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 528
            },
            "alto": {
              "type": "integer",
              "minimum": 1,
              "maximum": 528
            }
          }
        }
      }
    },
    "objetoDeCatalogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "tipo"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "tipo": {
          "enum": [
            "PERSON",
            "OBJECT",
            "ROUTE",
            "TOOL",
            "WARNING",
            "EXIT",
            "PROP",
            "TOOL_TARGET",
            "TRIGGER",
            "NOTE",
            "RESOURCE"
          ]
        },
        "arte": {
          "$ref": "#/$defs/arte"
        },
        "textoInteraccion": {
          "$ref": "#/$defs/texto"
        },
        "alRevisar": {
          "$ref": "#/$defs/texto"
        },
        "efecto": {
          "enum": [
            "ninguno",
            "pista"
          ]
        },
        "animacionCerca": {
          "$ref": "#/$defs/animacionCerca"
        },
        "desdeModelo": {
          "$ref": "#/$defs/clave"
        },
        "hitos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clave"
          }
        }
      },
      "if": {
        "required": [
          "desdeModelo"
        ]
      },
      "else": {
        "required": [
          "arte",
          "textoInteraccion"
        ]
      }
    },
    "herramienta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "descripcion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "descripcion": {
          "$ref": "#/$defs/texto"
        },
        "arte": {
          "$ref": "#/$defs/arte"
        },
        "alRevisar": {
          "$ref": "#/$defs/texto"
        },
        "animacionCerca": {
          "$ref": "#/$defs/animacionCerca"
        },
        "desdeModelo": {
          "$ref": "#/$defs/clave"
        },
        "hitos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clave"
          }
        }
      },
      "if": {
        "required": [
          "desdeModelo"
        ]
      },
      "else": {
        "required": [
          "arte"
        ]
      }
    },
    "animacionCerca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hoja",
        "cuadros",
        "fps"
      ],
      "properties": {
        "hoja": {
          "$ref": "#/$defs/arte"
        },
        "cuadros": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "personaje": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "rol",
        "recipeId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/clave"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "rol": {
          "$ref": "#/$defs/texto"
        },
        "recipeId": {
          "$ref": "#/$defs/clave"
        }
      }
    },
    "hito": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "description",
        "decisive"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/clave"
        },
        "label": {
          "$ref": "#/$defs/texto"
        },
        "description": {
          "$ref": "#/$defs/texto"
        },
        "decisive": {
          "type": "boolean"
        }
      }
    }
  },
  "if": {
    "properties": {
      "esquema": {
        "enum": [
          2,
          3
        ]
      }
    }
  },
  "then": {
    "required": [
      "hitos",
      "nivelRiesgoPorDefecto"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "hitos"
          ]
        },
        {
          "required": [
            "nivelRiesgoPorDefecto"
          ]
        }
      ]
    }
  }
}
