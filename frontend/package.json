{
  "name": "psychosim-admin-panel",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:character-assets": "node --test scripts/character-manifest-lib.test.mjs scripts/visual-asset-manifest-lib.test.mjs",
    "test:kit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/character-kit/*.test.mjs\"",
    "kit:types": "tsc -p tsconfig.kit.json",
    "kit:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-kit/build.mjs",
    "kit:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-kit/check.mjs && tsc -p tsconfig.kit.json",
    "kit:laminas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-kit/laminas.mjs",
    "kit:retoque": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/character-kit/retoque.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/material": "^21.2.12",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@types/howler": "^2.2.13",
    "howler": "^2.2.4",
    "konva": "^10.3.0",
    "phaser": "^3.90.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "axe-core": "^4.12.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3"
  }
}
