  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "preparar": "node scripts/copiar-biblioteca.mjs",
    "prestart": "npm run preparar",
    "start": "ng serve",
    "prebuild": "npm run preparar",
    "build": "ng build",
    "pretest": "npm run preparar",
    "test": "ng test --watch=false",
    "ia": "node --env-file-if-exists=.env servidor/ia.mjs",
