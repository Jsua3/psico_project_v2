    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@anthropic-ai/sdk": "^1.3.0",
    "@dagrejs/dagre": "^1.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "ajv": "^8.17.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
