# =============================================================================
# SIEP / PsychoSim — Variables de entorno requeridas
# Copia este archivo a `.env` (gitignored) y cambia los valores reales.
# docker compose carga `.env` automáticamente desde este directorio.
# =============================================================================

# ── Docker / PostgreSQL ───────────────────────────────────────────────────────
# POSTGRES_PASSWORD: usada por Docker Compose para inicializar el contenedor de la BD.
POSTGRES_PASSWORD=cambia-esto-en-produccion
# DB_PASSWORD: usada por Django para conectarse a la BD (debe coincidir con POSTGRES_PASSWORD).
DB_PASSWORD=cambia-esto-en-produccion
# SIEP_DB_PORT: puerto host de la BD de DESARROLLO (proyecto Compose psico-project-v3).
# Cambia esto si el 5433 está ocupado por la BD de otro checkout.
SIEP_DB_PORT=5433

# ── Base de datos de PRUEBAS (docker-compose.test.yml, desechable/tmpfs) ──────
# La suite backend (npm run test:backend) usa una BD aislada psychosim_test.
# Los settings de test fallan si el DSN coincide con desarrollo o producción.
SIEP_TEST_DB_PORT=5544
SIEP_TEST_DB_PASSWORD=psychosim_test_only

# ── Django ────────────────────────────────────────────────────────────────────
# PLANTILLA: producción rechaza estos valores de ejemplo; genera uno propio (por ejemplo
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`). S5-1: ≥ 50 caracteres, ≥ 20 distintos.
# DJANGO_SECRET_KEY: la que Django lee en producción (settings.production).
DJANGO_SECRET_KEY=cambia-esto-en-produccion
# SECRET_KEY: puede usarse en docker-compose para servicios auxiliares; Django no la lee directamente.
SECRET_KEY=cambia-esto-en-produccion
# DATABASE_URL: alternativa a las variables DB_* separadas (si se define, tiene prioridad en dj-database-url).
DATABASE_URL=postgresql://psychosim:cambia-esto-en-produccion@localhost:5433/psychosim
DJANGO_SETTINGS_MODULE=psychosim.settings.production
DJANGO_ALLOWED_HOSTS=tu-dominio.edu.co
# S1-1: obligatoria con DJANGO_SETTINGS_MODULE=psychosim.settings.production (número de proxies de confianza;
# Railway pone uno y se mide en el primer despliegue). Ver backend_django/.env.example.
SIEP_TRUSTED_PROXIES=1
# S1-2: limitador de peticiones (inicio de sesión, solicitud de acceso, importaciones). Encendido por defecto;
# apagarlo (false) es solo un interruptor de emergencia. Las pruebas lo apagan a propósito.
SIEP_THROTTLE_ENABLED=true
# S2-6b: hosts https:// permitidos para el fondo de sala (separados por comas; vacío = solo rutas propias de /assets/).
SIEP_ALLOWED_ASSET_HOSTS=

DB_NAME=psychosim
DB_USER=psychosim
DB_HOST=localhost
DB_PORT=5433

# ── Security ──────────────────────────────────────────────────────────────────
# JWT_SECRET ya no firma nada ni lo exige producción: la firma de sesión se decide en S5-3.
# JWT_SECRET=cambia-esto-por-un-secreto-fuerte-de-al-menos-256-bits
JWT_EXPIRATION_HOURS=8
# S1-4 · Sesión revocable: cerrar sesión, cambiar la contraseña, desactivar o reactivar la cuenta y cambiar el rol
# dejan sin valor los tokens anteriores. Encendida por defecto; SIEP_SESSION_EPOCH_ENFORCE=false es solo un
# interruptor de emergencia (deja vivos los tokens ya emitidos).
# SIEP_SESSION_EPOCH_ENFORCE=true
# S1-5: días que vive una contraseña temporal (la de una aprobación o la que fija un ADMIN) antes de caducar. Pasado el
# plazo la clave deja de servir y la cuenta de estudiante vuelve a «pendiente»; un ADMIN no se desactiva por eso.
# Entero ≥ 1; por defecto 7. Un valor inválido impide arrancar. Comando: manage.py expire_temporary_passwords --dry-run
SIEP_TEMP_PASSWORD_DAYS=7
# S2-6a: tope del cuerpo de una petición, en bytes, ANTES de leerla (413 si lo pasa). Por defecto 1 MiB para el JSON,
# 3 MiB para el sobre de la importación de estudiantes (archivo de 2 MiB + multipart) y 2 MiB para la importación de casos
# (el importador responde su propio error hasta ahí). Enteros ≥ 1; un valor inválido impide arrancar.
# SIEP_MAX_BODY_BYTES=1048576
# SIEP_MAX_IMPORT_BODY_BYTES=3145728
# SIEP_MAX_CASE_IMPORT_BODY_BYTES=2097152
GOOGLE_OAUTH_CLIENT_ID=tu-client-id-web-de-google.apps.googleusercontent.com
# GOOGLE_ALLOWED_DOMAINS=tu-institucion.edu.co  # dominios de correo que pueden entrar con Google, separados por comas; vacío = sin restricción (SD-14)
# REFLECTION_ENCRYPTION_KEY: OBLIGATORIA en producción (S5-1): ≥ 32 caracteres, ≥ 20 distintos, distinta de
# DJANGO_SECRET_KEY y sin heredarla de JWT_SECRET. PLANTILLA: producción rechaza este valor de ejemplo.
REFLECTION_ENCRYPTION_KEY=cambia-esto-por-un-secreto-fuerte
# S5-2 · Llaves versionadas de las reflexiones, para rotar sin perder bitácoras. Sin ellas la activa es la heredada
# (local-aes-gcm-v1) y así funciona el desarrollo. En producción REFLECTION_ACTIVE_KEY es OBLIGATORIA, debe ser el id de
# una llave de REFLECTION_KEYS y nunca local-aes-gcm-v1.
# REFLECTION_KEYS: pares id=secreto separados por comas. Los ids son de [A-Za-z0-9_.-] (1 a 40 caracteres); cada secreto
# tiene ≥ 32 caracteres, ≥ 20 distintos, no lleva comas y es distinto de DJANGO_SECRET_KEY.
# REFLECTION_ACTIVE_KEY: el id con el que se cifran las reflexiones nuevas.
# Para rotar: python manage.py rotate_reflection_key --dry-run y luego python manage.py rotate_reflection_key.
# REFLECTION_KEYS=<id>=<secreto-nuevo-generado-con-secrets.token_urlsafe>
# REFLECTION_ACTIVE_KEY=<id>

CORS_ALLOWED_ORIGINS=https://tu-dominio.edu.co

# Redirección HTTPS (S2-2): Django redirige a https por defecto; solo "false" la apaga. /api/health queda exento (sondeo de Railway).
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS: entero entre 0 y 63072000; 3600 al empezar. Escalera: 3600 → 86400 → 604800 → 15552000.
# Cada subida solo después de comprobar `curl -I http://tu-dominio.edu.co` (301 hacia https) y de una semana sin problemas.
# Verificación y retroceso en docs/operacion/despliegue-railway.md (sección «HTTPS y HSTS»).
SIEP_HSTS_SECONDS=3600
# S2-5, SOLO DESARROLLO: true expone /schema/ y /swagger-ui.html a un ADMIN con sesión; apagado (por defecto y en producción) responden 404.
SIEP_EXPOSE_API_DOCS=false

# ── AI Assistant (RF-027) ─────────────────────────────────────────────────────
# Apagado por defecto: sin AI_ASSISTANT_ENABLED=true la ruta responde 404 aunque haya clave.
# No lo actives sin concepto jurídico escrito (Ley 1581/2012): envía texto del estudiante a un proveedor externo.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_PROVIDER=openai
AI_ASSISTANT_API_KEY=cambia-esto-por-tu-clave-de-openai
AI_ASSISTANT_MODEL=gpt-4o-mini
